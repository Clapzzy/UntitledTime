@page "/counter"
@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))
@inject IDbContextFactory<SpotifyDbContext> DbFactory
@using Frontend.Data.Models

<PageTitle>Counter</PageTitle>

<h1>Counter</h1>

<p role="status">Current count: @currentCount</p>

<button class="btn btn-primary" @onclick="PrintShows">
    Click me
</button>

<div class="w-50 h-50 bg-black bg-red-100">
</div>

@code {
    private int currentCount;

    private async Task PrintShows()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var shows = await db.PodcastShows.ToListAsync();

        foreach (var show in shows)
        {
            Console.WriteLine("bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb");
            Console.WriteLine($"{show.ShowName} - {show.MsPlayed}ms");
        }
        Console.WriteLine("aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa");
    }
    private async Task AddItem()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        await db.Database.ExecuteSqlRawAsync("INSERT INTO podcastShows VALUES ('hellow',30)");
    }
    protected override async Task OnInitializedAsync()
    {
    }

}